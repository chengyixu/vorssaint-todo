{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@todo/domain/*": ["src/todo/domain/*"],
      "@todo/application/*": ["src/todo/application/*"],
      "@todo/infrastructure/*": ["src/todo/infrastructure/*"],
      "@todo/shared/*": ["src/shared/*"]
    },
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
